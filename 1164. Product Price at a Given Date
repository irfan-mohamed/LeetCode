WITH numbered_cte AS(
    SELECT
        product_id,
        new_price,
        ROW_NUMBER() OVER(PARTITION BY product_id ORDER BY change_date DESC) AS row_num
    FROM
        Products
    WHERE
        change_date <= '2019-08-16'
)
SELECT
    p.product_id,
    10 AS price
FROM
    (SELECT DISTINCT product_id FROM Products) AS p
WHERE
    p.product_id NOT IN (SELECT DISTINCT product_id FROM numbered_cte)

UNION ALL

SELECT
    product_id,
    new_price AS price
FROM
    numbered_cte
WHERE
    row_num = 1
;
