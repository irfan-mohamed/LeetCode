-- Write your PostgreSQL query statement below
SELECT
    n.id,
    s.student
FROM
    (SELECT
        id,
        CASE
            WHEN id % 2 = 0 THEN id-1
            WHEN id % 2 = 1 AND id+1 NOT IN (SELECT id FROM Seat) THEN id
            ELSE id+1
        END AS new_id
    FROM
        Seat) AS n
JOIN Seat AS s ON n.new_id = s.id;
